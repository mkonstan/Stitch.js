{
  "name": "stitch-js",
  "version": "3.0.1",
  "private": false,
  "description": "Drop-in reactive data binding for browser apps.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node _tools/run-tests.js",
    "test:static": "node _tools/check-repo.js",
    "build": "npm run build:assembly && npm run build:min && npm run build:skill",
    "build:assembly": "node _tools/build-stitch-assembly.js",
    "build:assembly:all": "node _tools/build-stitch-assembly.js --mode=all",
    "build:min": "node minify.js",
    "build:skill": "node _tools/skill-errors.js",
    "test:acceptance": "node _tools/run-tests.js --acceptance"
  },
  "license": "MIT",
  "keywords": [
    "stitch",
    "mvvm",
    "reactivity",
    "data-binding",
    "browser"
  ],
  "devDependencies": {
    "playwright": "^1.58.2",
    "terser": "^5.44.0"
  }
}
